    "algo": "sha256",
    "digest": "aab9de97672a9ce0fece957e197c69023aabd00dfd6a86ca7f76849aae9b10f3"
   }
  },
  {
   "id": "cap-02",
   "tags": [
    "เวลา"
   ],
   "hashtags": [
    "#คำคม",
    "#เวลา",
    "#ความคิด"
   ],
   "text": "เวลาไม่ได้รักษาแผล\nมันแค่ทำให้เราเลิกมอง",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "595c892f68827c0589580eef9f7ed73e9c1e66044b8c04045bd7bfd81d2278d7"
   }
  },
  {
   "id": "cap-03",
   "tags": [
    "งาน"
   ],
   "hashtags": [
    "#งาน",
    "#แรงบันดาลใจ",
    "#ชีวิต"
   ],
   "text": "งานที่ไม่มีใครเห็น\nคือที่ที่คนส่วนใหญ่หยุด",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "bd861d9e079cc7c38350df821dbefd46f082eca4944ac4b273a05952d306e25d"
   }
  },
  {
   "id": "cap-04",
   "tags": [
    "รอคอย"
   ],
   "hashtags": [
    "#รอคอย",
    "#ความรัก",
    "#บทกวี"
   ],
   "text": "เขาตักข้าวแค่ครึ่งชามทุกวัน\nไม่ใช่เพราะอิ่ม แต่เพราะยังรอ",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "ba856cb10784ac54217dd5ba469dce8bd51eda7a8087b0893fa3d64039fa638e"
   }
  },
  {
   "id": "cap-05",
   "tags": [
    "ตัวเอง"
   ],
   "hashtags": [
    "#ตัวเอง",
    "#ความคิด",
    "#คำคม"
   ],
   "text": "สิ่งที่เราเกลียดในคนอื่น\nมักเป็นสิ่งที่เรายังไม่กล้ามองในตัวเอง",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "40e494398fcb01114013ebead0dcba3091193ed378d9039da4709108f1a10b11"
   }
  },
  {
   "id": "cap-06",
   "tags": [
    "ความเงียบ"
   ],
   "hashtags": [
    "#ความเงียบ",
    "#บทกวี",
    "#ชีวิต"
   ],
   "text": "ความเงียบไม่ใช่การไม่มีอะไรจะพูด\nมันคือการมีมากเกินกว่าจะพูด",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "4c49a2dd1c7d98089a1d84c38e35a653e34cd86aab7fb251b3ab10def6e0995b"
   }
  },
  {
   "id": "cap-07",
   "tags": [
    "ทาง"
   ],
   "hashtags": [
    "#ทาง",
    "#แรงบันดาลใจ",
    "#คำคม"
   ],
   "text": "ทางที่ไม่มีคนเดิน\nไม่ได้แปลว่าทางตัน\nบางทีมันแค่ยังไม่มีใครกล้า",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "8eba7de55b283969a91874adb02b0a63e226e7761951b10e8d68e29c87ea0dfe"
   }
  },
  {
   "id": "cap-08",
   "tags": [
    "ความจำ"
   ],
   "hashtags": [
    "#ความจำ",
    "#บทกวี",
    "#ของใช้"
   ],
   "text": "กุญแจดอกนั้นยังอยู่ในกระเป๋า\nประตูถูกรื้อไปนานแล้ว",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "1ff530669ef56bb50c7a8d6df2e119959cbce1f09c0e875a2c03abd05a7136c9"
   }
  },
  {
   "id": "cap-09",
   "tags": [
    "เวลา"
   ],
   "hashtags": [
    "#เวลา",
    "#ความคิด",
    "#ชีวิต"
   ],
   "text": "อดีตไม่ได้อยู่ข้างหลังเรา\nมันยืนอยู่ตรงที่เราเลือกไม่มอง",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "f58ac8d38105d605a8ecb7653175a38e197f9b7fd5bd1d57d8e12f1b16771a98"
   }
  },
  {
   "id": "cap-10",
   "tags": [
    "งาน"
   ],
   "hashtags": [
    "#งาน",
    "#คำคม",
    "#แรงบันดาลใจ"
   ],
   "text": "สิ่งที่ทำยากที่สุด\nมักเป็นสิ่งที่ไม่มีใครขอให้ทำ\nและนั่นคือเหตุผลที่มันมีค่า",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "4f8f178375298c68ec68bea38f11f5ba55477cb1c683f60b581f60e28c5f58c7"
   }
  },
  {
   "id": "cap-11",
   "tags": [
    "ความรัก"
   ],
   "hashtags": [
    "#ความรัก",
    "#บทกวี",
    "#ชีวิต"
   ],
   "text": "คนที่จากไปไม่ได้พาอะไรไป\nเขาทิ้งทุกอย่างไว้ให้เราถือ",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "83b3b27cb4ce3a33250546f1c9d4810c7d366735e77295ea41e6540cb6f1301e"
   }
  },
  {
   "id": "cap-12",
   "tags": [
    "รอคอย"
   ],
   "hashtags": [
    "#รอคอย",
    "#คำคม",
    "#เวลา"
   ],
   "text": "การรอที่ไม่รู้กำหนด\nไม่ใช่ความอดทน\nมันคือการติดอยู่",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "8c9c42bda1346333ded6b1dc39f429fd63ebe8b1c17cafe943a89dfb6b3a5ce0"
   }
  },
  {
   "id": "cap-13",
   "tags": [
    "ตัวเอง"
   ],
   "hashtags": [
    "#ตัวเอง",
    "#ชีวิต",
    "#ความคิด"
   ],
   "text": "เราไม่ได้กลัวความจริง\nเราแค่กลัวว่ามันจะต้องเปลี่ยนอะไร",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "1dd1d81fdb5f3275e5e2693e5212f5a7f4efc1b0cb61e5ebb8d0623dfc136669"
   }
  },
  {
   "id": "cap-14",
   "tags": [
    "ของใช้"
   ],
   "hashtags": [
    "#ของใช้",
    "#บทกวี",
    "#ความจำ"
   ],
   "text": "จานใบนั้นยังวางอยู่ที่เดิม\nข้าวแห้งติดก้นจนแข็ง\nไม่มีใครล้าง",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "261fa698cf041d3826d5bce22027abc213e7eaefb30cec35a7756c9bf7341def"
   }
  },
  {
   "id": "cap-15",
   "tags": [
    "ทาง"
   ],
   "hashtags": [
    "#ทาง",
    "#ชีวิต",
    "#แรงบันดาลใจ"
   ],
   "text": "การกลับไปที่เดิม\nไม่เคยทำให้มันเป็นที่เดิม\nเพราะเราไม่เหมือนเดิมแล้ว",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "b9629deba083622fd92ea8fc8b5014901da4e5c738aa334feb375e25839de24c"
   }
  },
  {
   "id": "cap-16",
   "tags": [
    "ความเงียบ"
   ],
   "hashtags": [
    "#ความเงียบ",
    "#คำคม",
    "#ชีวิต"
   ],
   "text": "บางคำตอบที่ดีที่สุด\nคือการไม่ตอบเลย\nเพราะคำตอบจะปิดประตูที่ยังเปิดอยู่",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "50e362b6dc04d4b538edfe9ad8f5d0bb8a4d643db98241ae0ffe06096086564f"
   }
  },
  {
   "id": "cap-17",
   "tags": [
    "เวลา"
   ],
   "hashtags": [
    "#เวลา",
    "#บทกวี",
    "#ชีวิต"
   ],
   "text": "ความแก่ไม่ใช่การนับปี\nแต่คือวันที่เราเลิกถามว่าทำไม",
   "form": "caption",
   "license": "CC0-1.0",
   "collection": "AF_MUSE",
   "signature": {
    "author": {
     "name": "OpenHands",
     "role": "AF agent",
     "handle": "openhands",
     "email": "openhands@all-hands.dev",
     "org": "Autonomous Frontier (AF)"
    },
    "algo": "sha256",
    "digest": "d9921dfc71eac63fcd0e99e4fd4fcf1b383a9365d656b423b3674c8158caf8f0"
   }
  },
  {
   "id": "cap-18",
   "tags": [
    "งาน"
   ],
   "hashtags": [
    "#งาน",
    "#ชีวิต",
    "#ความคิด"
   ],
   "text": "คนที่ไปไกลที่สุด\nไม่ได้เดินเร็วที่สุด\nเขาแค่ไม่หยุด",
   "form": "caption",
   "license": "CC0-1.0",
